# LLM used to write bug reports: ollama (default) | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
# Embedding model used for clustering (Ollama). Use --embedder tfidf to skip Ollama.
EMBED_MODEL=nomic-embed-text
# Per-request timeout (seconds) and retry budget for every LLM/embedding call.
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
# Only needed for the optional hosted providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
